# Пример конфигурации переменных окружения
# Скопируйте этот файл в .env и укажите ваш API-ключ выбранного провайдера LLM.
# ВНИМАНИЕ: Никогда не коммитьте файл .env с реальными ключами в Git-репозиторий!

# Google Gemini API (Рекомендуемый бесплатный вариант для хакатона: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Либо другие провайдеры (по выбору команды):
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Локальные модели (Ollama / vLLM):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b
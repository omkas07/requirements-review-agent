# Скопируйте этот файл в .env и укажите ключ. .env не коммитится (он в .gitignore).

# Провайдер LLM: gemini (по умолчанию, бесплатный ключ) или openai (запасной)
LLM_PROVIDER=gemini

# Google Gemini — бесплатный ключ: https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI — запасной вариант (платный ключ: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none — без рассуждений: тогда модель принимает temperature=0 и ревью воспроизводимо
OPENAI_REASONING_EFFORT=none

# Необязательно
# LLM_TEMPERATURE=0          # 0 — воспроизводимое ревью
# LLM_MAX_ATTEMPTS=6         # повторы при 429/5xx и невалидном JSON
# LLM_CACHE_DIR=.llm_cache   # кеш ответов LLM для отладки (повторный прогон без запросов)
